const fs = require('fs');

const LOGO_URL = "data:image/png;base64,";

// ===== 1. APP MOTORISTA =====
let mot = fs.readFileSync('src/public/motorista-app.html', 'utf8');

mot = mot.replace(
    `<h1 id="headerMarca">\ud83d\ude97 Motorista</h1>`,
    `<div style="display:flex;align-items:center;gap:10px;">
                <img src="${LOGO_URL}" style="height:36px;width:36px;border-radius:6px;object-fit:cover;" alt="Rebecar">
                <div style="display:flex;flex-direction:column;gap:1px;">
                    <span id="headerMarca" style="font-size:15px;font-weight:700;color:#FFD700;letter-spacing:1px;">REBECAR</span>
                    <span id="headerNomeMotorista" style="font-size:11px;color:#aad4ff;font-weight:500;display:none;"></span>
                </div>
            </div>`
);

// Login screen (segunda ocorrência)
mot = mot.replace(
    `<h1 id="headerMarca">\ud83d\ude97 Motorista</h1>`,
    `<div style="display:flex;align-items:center;gap:10px;justify-content:center;">
                <img src="${LOGO_URL}" style="height:36px;width:36px;border-radius:6px;object-fit:cover;" alt="Rebecar">
                <span id="headerMarca" style="font-size:15px;font-weight:700;color:#FFD700;letter-spacing:1px;">REBECAR</span>
            </div>`
);

fs.writeFileSync('src/public/motorista-app.html', mot);
console.log('✅ Header motorista atualizado');

// ===== 2. ADMIN =====
let adm = fs.readFileSync('src/public/admin/index.html', 'utf8');

adm = adm.replace(
    `<h1 id="headerNomeMarca">Rebeca</h1>`,
    `<div style="display:flex;align-items:center;gap:10px;">
                <img src="${LOGO_URL}" style="height:34px;width:34px;border-radius:6px;object-fit:cover;" alt="Rebecar">
                <div style="display:flex;flex-direction:column;gap:0px;">
                    <span id="headerNomeMarca" style="font-size:14px;font-weight:700;color:#FFD700;letter-spacing:1px;">REBECAR</span>
                    <span style="font-size:10px;color:#aaa;letter-spacing:0.5px;">Painel Admin</span>
                </div>
            </div>`
);

// Atualizar title
adm = adm.replace('<title>Rebeca - Painel Admin</title>', '<title>Rebecar - Painel Admin</title>');

fs.writeFileSync('src/public/admin/index.html', adm);
console.log('✅ Header admin atualizado');